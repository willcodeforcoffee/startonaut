<div class="w-full font-pt-sans">
  <div class="flex flex-col justify-between mb-6">
    <h1 class="font-pt-sans font-bold text-4xl mb-16">Welcome to Startonaut</h1>
    <div>
      <%= primary_link_to "New bookmark", new_bookmark_path %>
    </div>
  </div>
  <% if @favorite_tags.any? %>
    <div class="w-full mb-6">
      <h2 class="font-semibold text-2xl mb-4 mr-6">Favorite Tags</h2>
      <div class="flex flex-row flex-wrap gap-2 items-center">
        <% @favorite_tags.each do |tag| %>
          <%= link_to toggle_tag_filter_path(tag.name), class: tag_filter_link_classes(tag.name, size: "px-3 py-1"), aria: { pressed: selected_tag_names.include?(tag.name) } do %>
            #<%= tag.name %>
            <span class="ml-1 opacity-60">(<%= tag.bookmarks_count %>)</span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if @read_later_bookmarks.any? %>
    <%= render "icon_panel", title: "Read Later Bookmarks", bookmarks: @read_later_bookmarks %>
  <% end %>
  <% if @today_bookmarks.any? %>
    <%= render "icon_panel", title: "##{Tag.todays_name}", bookmarks: @today_bookmarks %>
  <% end %>
  <%= render "shared/search", path: search_pages_path, tags: selected_tag_names %>
  <!-- Main content area with bookmarks and tags sidebar -->
  <h2 class="font-semibold text-2xl mb-4 mr-6">All Bookmarks</h2>
  <div class="flex flex-col lg:flex-row gap-6">
    <!-- Tags sidebar - appears first on mobile (top), second on desktop (right) -->
    <%= render "shared/tag_filter_sidebar", tags_by_letter: @tags_by_letter %>
    <!-- Bookmarks list (main content) - appears second on mobile (bottom), first on desktop (left) -->
    <div class="flex-1 order-2 lg:order-1">
      <%= render "shared/tag_filter_summary" %>
      <% if @bookmarks.any? %>
        <ul role="list" class="mx-auto mt-5 gap-x-8 gap-y-16 text-center max-w-2xl grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:mx-0 lg:max-w-none lg:grid-cols-5 xl:grid-cols-6">
          <% @bookmarks.each do |bookmark| %>
            <li>
              <%= render "bookmarks/bookmark_icon", bookmark: bookmark %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <% if selected_tag_names.any? %>
          <p class="text-center my-10">No bookmarks have all of the selected tags.</p>
        <% else %>
          <p class="text-center my-10">You haven't created any bookmarks yet!</p>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
