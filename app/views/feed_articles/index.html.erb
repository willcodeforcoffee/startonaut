<% content_for :title, "Feed" %>
<div class="w-full font-pt-sans">
  <div class="flex justify-between items-center">
    <h1 class="font-pt-sans font-bold text-4xl">Feed</h1>
  </div>
  <div class="flex flex-col lg:flex-row gap-6 mt-5">
    <% unless turbo_frame_request? %>
      <!-- Tags sidebar - appears first on mobile (top), second on desktop (right) -->
      <%= render "shared/tag_filter_sidebar", tags_by_letter: @tags_by_letter %>
    <% end %>
    <!-- Articles (main content) - appears second on mobile (bottom), first on desktop (left) -->
    <div class="flex-1 order-2 lg:order-1">
      <%= render "shared/tag_filter_summary" %>
      <%= render "feed_articles/page",
        feed_articles: @feed_articles,
        next_cursor: @next_cursor,
        next_page_path: (feed_articles_path(before: @next_cursor, tags: selected_tag_names.join(",").presence) if @next_cursor),
        show_source: true,
        description_length: 500,
        empty_message: (selected_tag_names.any? ? "No articles from bookmarks with all of the selected tags." : "No articles found yet.") %>
    </div>
  </div>
</div>
