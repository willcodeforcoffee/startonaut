<a href="<%= bookmark.url %>" target="_blank" rel="noopener noreferrer" class="text-baby-powder-50 hover:underline">
  <span class="relative mx-auto block size-12 md:size-24">
    <%= favicon_image_tag(bookmark, class: "size-12 md:size-24 rounded-[1vw] outline-1 -outline-offset-1 outline-black/5 dark:outline-bright-turquoise-300/10") %>
    <% if bookmark.feed_url.present? # Show the feed icon over the favicon %>
      <span title="This site has a feed" class="text-bright-turquoise-300 absolute bottom-1 left-1 inline-flex size-5"><%= feed_icon %></span>
    <% end %>
  </span>
  <p class="mt-3 text-base/7 font-pt-sans-narrow font-semibold tracking-tight"><%= bookmark.title %></p>
</a>
